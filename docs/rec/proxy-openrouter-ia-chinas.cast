[148.481, "o", "\u001b[90m┌─ run.sh · arranque ───────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[148.481, "o", "\u001b[90m   1\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#!/usr/bin/env bash\u001b[39;49;00m\n"]
[148.536, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Ejecución MANUAL en PRIMER PLANO del proxy OpenRouter de IA (chinas).\u001b[39;49;00m\n"]
[148.591, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   - Arranca el servicio en el puerto 8001 (endpoint /api/query).\u001b[39;49;00m\n"]
[148.646, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   - Se ejecuta en la terminal actual (no en segundo plano).\u001b[39;49;00m\n"]
[148.701, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   - Para DETENERLO: pulsa Ctrl+C.\u001b[39;49;00m\n"]
