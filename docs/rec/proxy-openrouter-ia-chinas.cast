[79.595, "o", "\u001b[90m 101\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# 429 (rate limit) => backoff largo; otros errores => backoff corto\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
