[11.777, "o", "\u001b[90m┌─ server.py · objetivo ────────────────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[11.777, "o", "\u001b[90m   1\u001b[0m\u001b[90m │ \u001b[0m\u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mServidor proxy local de OpenRouter para modelos IA gratuitos (prioridad china).\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[11.832, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[11.887, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0mExpone un único endpoint pensado para microcontroladores (ESP8266) y scripts:\u001b[90m\u001b[39;49;00m\n"]
[11.942, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[11.997, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m  GET /api/query\u001b[04m\u001b[91m?\u001b[39;49;00mq=<pregunta>[&key=sk-\u001b[95mor\u001b[39;49;00m-v1-...]\u001b[90m\u001b[39;49;00m\n"]
[12.052, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[12.107, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0mDevuelve JSON compacto (sin streaming):\u001b[90m\u001b[39;49;00m\n"]
[12.162, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m  - Éxito: {\u001b[33m\"\u001b[39;49;00m\u001b[33mok\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: true, \u001b[33m\"\u001b[39;49;00m\u001b[33mmodel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33m<id>\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mtext\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33m<respuesta>\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: null}\u001b[90m\u001b[39;49;00m\n"]
[12.217, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m  - Falla: {\u001b[33m\"\u001b[39;49;00m\u001b[33mok\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: false, \u001b[33m\"\u001b[39;49;00m\u001b[33mmodel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: null, \u001b[33m\"\u001b[39;49;00m\u001b[33merror\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33m<detalle>\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\n"]
[12.272, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[12.327, "o", "\u001b[90m  11\u001b[0m\u001b[90m │ \u001b[0mReutiliza el pool de modelos gratuitos con failover y prioridad a modelos chinos.\u001b[90m\u001b[39;49;00m\n"]
[12.382, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0mLa API key se toma de .env (OPENROUTER_API_KEY) o se puede pasar por parametro \u001b[04m\u001b[91m`\u001b[39;49;00mkey\u001b[04m\u001b[91m`\u001b[39;49;00m.\u001b[90m\u001b[39;49;00m\n"]
