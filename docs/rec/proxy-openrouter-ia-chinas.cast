[94.251, "o", "\u001b[90m┌─ src/router.py · FreeModelRouter.stream() ────────────────────────────────────────────────────────────\u001b[0m\n"]
[94.251, "o", "\u001b[90m  30\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mstream\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, messages: \u001b[96mlist\u001b[39;49;00m[\u001b[96mdict\u001b[39;49;00m]):\u001b[90m\u001b[39;49;00m\n"]
[94.306, "o", "\u001b[90m  31\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mItera el pool y devuelve (model_id, iterable) del primer modelo que responde.\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[94.361, "o", "\u001b[90m  32\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[94.416, "o", "\u001b[90m  33\u001b[0m\u001b[90m │ \u001b[0m        Devuelve el modelo elegido y un generador de fragmentos. Si todos\u001b[90m\u001b[39;49;00m\n"]
[94.471, "o", "\u001b[90m  34\u001b[0m\u001b[90m │ \u001b[0m        fallan, levanta RouterError con el detalle de cada intento.\u001b[90m\u001b[39;49;00m\n"]
[94.526, "o", "\u001b[90m  35\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[94.581, "o", "\u001b[90m  36\u001b[0m\u001b[90m │ \u001b[0m        available = \u001b[96mself\u001b[39;49;00m.pool.available_models()\u001b[90m\u001b[39;49;00m\n"]
[94.636, "o", "\u001b[90m  37\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m available:\u001b[90m\u001b[39;49;00m\n"]
[94.691, "o", "\u001b[90m  38\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mraise\u001b[39;49;00m RouterError(\u001b[33m\"\u001b[39;49;00m\u001b[33mNo hay ningún modelo gratuito disponible en este momento.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[94.746, "o", "\u001b[90m  39\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[94.801, "o", "\u001b[90m  40\u001b[0m\u001b[90m │ \u001b[0m        attempts: \u001b[96mlist\u001b[39;49;00m[\u001b[96mstr\u001b[39;49;00m] = []\u001b[90m\u001b[39;49;00m\n"]
[94.856, "o", "\u001b[90m  41\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Prioridad: primero los modelos chinos, luego el resto. Dentro de cada\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[94.911, "o", "\u001b[90m  42\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# grupo, orden estable por nombre para un comportamiento predecible.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[94.966, "o", "\u001b[90m  43\u001b[0m\u001b[90m │ \u001b[0m        candidates = \u001b[96msorted\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[95.021, "o", "\u001b[90m  44\u001b[0m\u001b[90m │ \u001b[0m            available,\u001b[90m\u001b[39;49;00m\n"]
[95.076, "o", "\u001b[90m  45\u001b[0m\u001b[90m │ \u001b[0m            key=\u001b[94mlambda\u001b[39;49;00m m: (\u001b[95mnot\u001b[39;49;00m m.is_chinese, m.name.lower()),\u001b[90m\u001b[39;49;00m\n"]
[95.131, "o", "\u001b[90m  46\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[95.186, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[95.241, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m model \u001b[95min\u001b[39;49;00m candidates:\u001b[90m\u001b[39;49;00m\n"]
[95.296, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[95.351, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0m                logger.info(\u001b[33m\"\u001b[39;49;00m\u001b[33mIntentando con modelo gratuito: \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, model.id)\u001b[90m\u001b[39;49;00m\n"]
[95.406, "o", "\u001b[90m  51\u001b[0m\u001b[90m │ \u001b[0m                stream = \u001b[96mself\u001b[39;49;00m.client.chat_stream(model.id, messages)\u001b[90m\u001b[39;49;00m\n"]
[95.461, "o", "\u001b[90m  52\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# Verificar que realmente arranca (evita modelos muertos)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[95.516, "o", "\u001b[90m  53\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m.pool.mark_success(model.id)\u001b[90m\u001b[39;49;00m\n"]
[95.571, "o", "\u001b[90m  54\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m._stream = model.id\u001b[90m\u001b[39;49;00m\n"]
[95.626, "o", "\u001b[90m  55\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mreturn\u001b[39;49;00m model.id, stream\u001b[90m\u001b[39;49;00m\n"]
[95.681, "o", "\u001b[90m  56\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mexcept\u001b[39;49;00m RateLimitError \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\n"]
[95.736, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m.pool.mark_failure(model.id, \u001b[96mstr\u001b[39;49;00m(exc), \u001b[94m429\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[95.791, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0m                attempts.append(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmodel.id\u001b[33m}\u001b[39;49;00m\u001b[33m: rate limit (429)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[95.846, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m                logger.warning(\u001b[33m\"\u001b[39;49;00m\u001b[33mModelo \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m con rate limit, probando siguiente\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, model.id)\u001b[90m\u001b[39;49;00m\n"]
[95.901, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mexcept\u001b[39;49;00m APIStatusError \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\n"]
[95.956, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m.pool.mark_failure(model.id, \u001b[96mstr\u001b[39;49;00m(exc), exc.status_code)\u001b[90m\u001b[39;49;00m\n"]
[96.011, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0m                attempts.append(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmodel.id\u001b[33m}\u001b[39;49;00m\u001b[33m: HTTP \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mexc.status_code\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[96.066, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0m                logger.warning(\u001b[33m\"\u001b[39;49;00m\u001b[33mModelo \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m falló: \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, model.id, exc)\u001b[90m\u001b[39;49;00m\n"]
[96.121, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mexcept\u001b[39;49;00m APIConnectionError \u001b[94mas\u001b[39;49;00m exc:\u001b[90m\u001b[39;49;00m\n"]
