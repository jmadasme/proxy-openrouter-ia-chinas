[109.684, "o", "\u001b[90m┌─ src/openrouter_client.py · chat_stream() ────────────────────────────────────────────────────────────\u001b[0m\n"]
[109.684, "o", "\u001b[90m  28\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mchat_stream\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, model_id: \u001b[96mstr\u001b[39;49;00m, messages: \u001b[96mlist\u001b[39;49;00m[\u001b[96mdict\u001b[39;49;00m]):\u001b[90m\u001b[39;49;00m\n"]
[109.739, "o", "\u001b[90m  29\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mDevuelve un iterable de fragmentos (streaming) del modelo indicado.\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[109.794, "o", "\u001b[90m  30\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[109.849, "o", "\u001b[90m  31\u001b[0m\u001b[90m │ \u001b[0m        Lanza openai.APIError / APIConnectionError / etc. en caso de fallo,\u001b[90m\u001b[39;49;00m\n"]
[109.904, "o", "\u001b[90m  32\u001b[0m\u001b[90m │ \u001b[0m        para que el router los capture y pruebe el siguiente modelo.\u001b[90m\u001b[39;49;00m\n"]
[109.959, "o", "\u001b[90m  33\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[110.014, "o", "\u001b[90m  34\u001b[0m\u001b[90m │ \u001b[0m        resp = \u001b[96mself\u001b[39;49;00m.client.chat.completions.create(\u001b[90m\u001b[39;49;00m\n"]
[110.069, "o", "\u001b[90m  35\u001b[0m\u001b[90m │ \u001b[0m            model=model_id,\u001b[90m\u001b[39;49;00m\n"]
[110.124, "o", "\u001b[90m  36\u001b[0m\u001b[90m │ \u001b[0m            messages=messages,\u001b[90m\u001b[39;49;00m\n"]
[110.179, "o", "\u001b[90m  37\u001b[0m\u001b[90m │ \u001b[0m            stream=\u001b[94mTrue\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[110.234, "o", "\u001b[90m  38\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[110.289, "o", "\u001b[90m  39\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m chunk \u001b[95min\u001b[39;49;00m resp:\u001b[90m\u001b[39;49;00m\n"]
[110.344, "o", "\u001b[90m  40\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m chunk.choices \u001b[95mand\u001b[39;49;00m chunk.choices[\u001b[94m0\u001b[39;49;00m].delta \u001b[95mand\u001b[39;49;00m chunk.choices[\u001b[94m0\u001b[39;49;00m].delta.content:\u001b[90m\u001b[39;49;00m\n"]
